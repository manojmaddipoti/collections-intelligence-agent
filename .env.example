# Gemini API key (get a free one at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_api_key_here

# Use Google AI Studio (not Vertex AI) as the backend for ADK
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Authenticated human approval. Each identity has a distinct long random token.
# Store the JSON object in Secret Manager for deployment.
APPROVER_ID=reviewer@example.com
APPROVER_CREDENTIALS_JSON={"reviewer@example.com":"replace_with_a_long_random_value"}

# Optional durable Postgres store for mutable draft/approval state.
# Leave unset for the local SQLite demo.
# DRAFT_DATABASE_URL=postgresql://user:password@host:5432/collections
